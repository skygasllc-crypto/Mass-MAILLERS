# ---------------------------------------------------------------
# Mass Mailer configuration. Copy to .env and edit.
# SMTP host/username/password are entered in the web UI and stored
# encrypted in data/mailer.db - never put them in source code.
# ---------------------------------------------------------------

# development = NO real emails; messages appear in the built-in test mailbox.
# production  = real sending (requires a successful "Test SMTP Connection").
EMAIL_MODE=development

# The main administrator account (created automatically). Sign in with this email + password.
# The password is re-applied from this file at every start, so this is also how you reset it.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-me-please

# User accounts. Anyone can create an account; each user brings their own SMTP account.
ALLOW_REGISTRATION=true
# true = new accounts must be approved by an admin before they can sign in.
REGISTRATION_REQUIRES_APPROVAL=false
# Regular users may only use public SMTP servers on standard ports (25/465/587/2525), so nobody can
# use "Test SMTP Connection" to probe your internal network. Admins are exempt.
ALLOW_PRIVATE_SMTP_HOSTS=false

# Long random string used to sign sessions and encrypt the stored SMTP password.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If you change it later, re-enter the SMTP password.
SECRET_KEY=

# Web server. Keep 127.0.0.1 unless the app sits behind an HTTPS reverse proxy.
HOST=127.0.0.1
PORT=8000
# Number of reverse proxies in front of the app, used to find the visitor's real IP for rate limiting.
# 0 when running directly; 1 on Render or behind a single nginx/Caddy.
TRUSTED_PROXY_HOPS=0
# Send cookies only over HTTPS (defaults to true in production). Set false only for plain-http localhost use.
# COOKIE_SECURE=true

# Folder where saved email templates are kept (one sub-folder per template).
# TEMPLATES_DIR=./templates

# Limits
MAX_RECIPIENTS=10000
# Sends one user may run at once, each through a different SMTP account.
MAX_PARALLEL_SENDS=50
DEFAULT_BATCH_SIZE=100
# Hard cap on recipients per SMTP message. Set this to your SMTP provider's limit.
SMTP_MAX_RECIPIENTS_PER_MESSAGE=500
MAX_ATTACHMENT_MB=10
MAX_MESSAGE_MB=20
ALLOWED_ATTACHMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,png,jpg,jpeg,zip,txt
# Administrators only: allow .exe/.bat/.cmd/.scr/.ps1 etc. (strongly discouraged)
ALLOW_EXECUTABLE_ATTACHMENTS=false

# SMTP behaviour
SMTP_TIMEOUT=30
MAX_RETRIES=2
# Seconds before retrying a temporary (4xx) failure. Default: 60 in production, 1 in development.
# RETRY_DELAY_SECONDS=60
# Only set to false for a local test server with a self-signed certificate.
SMTP_TLS_VERIFY=true
